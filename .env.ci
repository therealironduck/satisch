# shellcheck disable=SC2034
################################
#           App Info           #
################################

# The environment may be `local`, `testing`, or `production`
APP_ENV=testing
APP_DEBUG=true
APP_NAME=Satisch

# The key should be auto generated. Use the `just build-key` command
APP_KEY=

# The public reachable URL of this app. This value is used for URL
# generation.
APP_URL=http://localhost


################################
#    Logging and Reporting     #
################################

# Here you may specify how the application should write log files.
# For local development `single` is recommended, on production `daily`
# and other logging sources.
# @see config/logging.php for details
LOG_STACK=single
LOG_LEVEL=debug


################################
#           Database           #
################################
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=satisch
DB_PASSWORD=secret


################################
#  Broadcasting / Websockets   #
################################

# This connection is used for Websockets. We use `laravel/reverb` as
# the websocket server.
BROADCAST_CONNECTION=log


################################
#       Caching & Queue        #
################################

# The queue connection defines which driver is used for the queue handling.
QUEUE_CONNECTION=sync

# The cache store defines which driver is used for the cache handling.
CACHE_STORE=array

################################
#           Mailing            #
################################
MAIL_MAILER=array
MAIL_FROM_ADDRESS="satisch@example.com"


################################
#         Integrations         #
################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


################################
#           Frontend           #
################################
VITE_APP_NAME="${APP_NAME}"


################################
#          Debugging           #
################################
TELESCOPE_ENABLED=false
PULSE_ENABLED=false

